<div class="top-row ps-3 navbar navbar-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Shopping List</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (!string.IsNullOrWhiteSpace(logoutError))
        {
            <div class="alert alert-warning mx-3" role="status">@logoutError</div>
        }
        <AuthorizeView>
            <Authorized Context="signedInContext">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="lists">Shopping list</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">Products</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="product-types">Product types</NavLink>
                </div>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminNavContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin">Administration</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <span class="nav-link">@signedInContext.User.Identity?.Name</span>
                </div>
                <div class="nav-item px-3">
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="adminContext">
                            <span class="nav-link">Administrator</span>
                        </Authorized>
                    </AuthorizeView>
                </div>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="LogoutAsync">Sign out</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Sign in</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">Register</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Inject]
    private IAuthenticationService Authentication { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool collapseNavMenu = true;
    private string? logoutError;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task LogoutAsync()
    {
        logoutError = null;
        try
        {
            await Authentication.LogoutAsync();
        }
        catch (HttpRequestException)
        {
            logoutError = "You are signed out, but the API could not be reached to revoke the refresh token.";
        }

        Navigation.NavigateTo("/login");
    }
}
