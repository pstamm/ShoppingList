@page "/lists/{Id:int}"
@attribute [Authorize]
@inject IShoppingListClient Lists
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>@(shoppingList?.Name ?? "Shopping list")</PageTitle>

<a href="/lists" class="btn btn-link px-0">&larr; All lists</a>

@if (isLoading)
{
    <p role="status">Loading shopping list...</p>
}
else if (shoppingList is null)
{
    <h1>Shopping list unavailable</h1>
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        @if (isEditingName)
        {
            <div class="d-flex gap-2">
                <InputText class="form-control" aria-label="List name" @bind-Value="editingName" />
                <button class="btn btn-primary" @onclick="SaveListNameAsync" disabled="@isSavingListName">Save</button>
                <button class="btn btn-outline-secondary" @onclick="CancelListNameEdit">Cancel</button>
            </div>
        }
        else
        {
            <h1 class="mb-0">@shoppingList.Name</h1>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary" @onclick="BeginListNameEdit">Rename list</button>
                @if (canManageShares)
                {
                    <a class="btn btn-outline-secondary" href="@($"/lists/{Id}/share")">Sharing</a>
                }
                <a class="btn btn-primary" href="@($"/lists/{Id}/products/new")">Add a product</a>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info" role="status">@statusMessage</div>
    }

    @if (items.Count == 0)
    {
        <p>This list is empty. Add a product to get started.</p>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
            <div>
                <label class="form-label" for="shopping-list-sort">Sort by</label>
                <InputSelect id="shopping-list-sort" class="form-select" @bind-Value="sortOrder">
                    <option value="@SortByProductType">Product type</option>
                    <option value="@SortAlphabetically">Alphabetic</option>
                </InputSelect>
            </div>
            <div class="form-check mb-2">
                <InputCheckbox id="positive-to-order-filter" class="form-check-input" @bind-Value="showOnlyPositiveToOrderNow" />
                <label class="form-check-label" for="positive-to-order-filter">Positive 'Order now'</label>
            </div>
        </div>

        @if (!DisplayedItems.Any())
        {
            <p>No products have a positive To order now value.</p>
        }
        else
        {
        <div class="table-responsive">
            <table class="table align-middle shopping-list-table">
                <colgroup>
                    <col class="shopping-list-product-column" />
                    <col class="shopping-list-quantity-column" />
                    <col class="shopping-list-quantity-column" />
                    <col class="shopping-list-notes-column" />
                    <col class="shopping-list-actions-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Typical order</th>
                        <th scope="col">Order now</th>
                        <th scope="col">Notes</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DisplayedItems)
                    {
                        <tr @key="item.Id">
                            <td class="shopping-list-product-cell">
                                <strong class="shopping-list-truncated" title="@item.ProductName">@item.ProductName</strong>
                                <div class="small text-body-secondary shopping-list-truncated" title="@($"{item.ProductTypeName} · {item.ProductPrice.ToString("C")}")">
                                    @item.ProductTypeName · @item.ProductPrice.ToString("C")
                                </div>
                            </td>
                            <td class="shopping-list-number-cell">@item.TipicalOrder</td>
                            <td class="shopping-list-number-cell">
                                <button type="button"
                                        class="btn btn-link p-0 shopping-list-quantity-trigger"
                                        aria-label="@($"Change order-now quantity for {item.ProductName}, currently {item.ToOrderNow}")"
                                        @onclick="() => BeginToOrderNowEdit(item)">
                                    @item.ToOrderNow
                                </button>
                            </td>
                            <td class="shopping-list-notes-cell">
                                <span class="shopping-list-truncated" title="@item.Notes">
                                    @(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)
                                </span>
                            </td>
                            <td class="shopping-list-actions-cell">
                                <div class="d-flex flex-wrap gap-1 shopping-list-actions">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/lists/{Id}/products/{item.Id}/edit")">Edit</a>
                                    @if (deletingItemId == item.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteItemAsync(item)" disabled="@isSavingItem">
                                            Confirm remove
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelItemDelete" disabled="@isSavingItem">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => BeginItemDelete(item)">Remove</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (editingToOrderItem is not null)
        {
            <div class="shopping-list-modal-backdrop" role="presentation">
                <section class="shopping-list-quantity-modal" role="dialog" aria-modal="true" aria-labelledby="quantity-modal-title">
                    <h2 id="quantity-modal-title" class="h5">Change order-now quantity</h2>
                    <p class="mb-3">@editingToOrderItem.ProductName</p>
                    <div class="d-flex align-items-center justify-content-center gap-3 mb-4">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                aria-label="Decrease quantity"
                                disabled="@(isSavingToOrderNow || editedToOrderNow == int.MinValue)"
                                @onclick="() => AdjustEditedToOrderNow(-1)">−</button>
                        <output class="shopping-list-quantity-value" aria-live="polite">@editedToOrderNow</output>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                aria-label="Increase quantity"
                                disabled="@(isSavingToOrderNow || editedToOrderNow == int.MaxValue)"
                                @onclick="() => AdjustEditedToOrderNow(1)">+</button>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@isSavingToOrderNow"
                                @onclick="CancelToOrderNowEdit">Cancel</button>
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@isSavingToOrderNow"
                                @onclick="SaveToOrderNowAsync">
                            @(isSavingToOrderNow ? "Saving..." : "Done")
                        </button>
                    </div>
                </section>
            </div>
        }
        }
    }
}

@code {
    private const string SortByProductType = "ProductType";
    private const string SortAlphabetically = "Alphabetic";
    private readonly List<ListProductDto> items = [];
    private ShoppingListDto? shoppingList;
    private string? errorMessage;
    private string? statusMessage;
    private string editingName = string.Empty;
    private int? deletingItemId;
    private int? editingToOrderItemId;
    private int editedToOrderNow;
    private bool isLoading = true;
    private bool isEditingName;
    private bool isSavingListName;
    private bool isSavingItem;
    private bool isSavingToOrderNow;
    private bool canManageShares;
    private bool showOnlyPositiveToOrderNow;
    private string sortOrder = SortByProductType;
    private string? currentUserId;
    private bool isAdmin;

    private ListProductDto? editingToOrderItem =>
        editingToOrderItemId is int itemId
            ? items.FirstOrDefault(item => item.Id == itemId)
            : null;

    private IEnumerable<ListProductDto> DisplayedItems
    {
        get
        {
            var filteredItems = showOnlyPositiveToOrderNow
                ? items.Where(item => item.ToOrderNow > 0)
                : items;

            return sortOrder == SortAlphabetically
                ? filteredItems.OrderBy(item => item.ProductName, StringComparer.CurrentCultureIgnoreCase)
                : filteredItems
                    .OrderBy(item => item.ProductTypeName, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(item => item.ProductName, StringComparer.CurrentCultureIgnoreCase);
        }
    }

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = await AuthenticationState.GetAuthenticationStateAsync();
        currentUserId = authenticationState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdmin = authenticationState.User.IsInRole("Admin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            shoppingList = await Lists.GetListAsync(Id);
            canManageShares = isAdmin ||
                (!string.IsNullOrWhiteSpace(currentUserId) && shoppingList.OwnerUserId == currentUserId);
            await LoadItemsAsync();
        }
        catch (ShoppingListApiException ex)
        {
            shoppingList = null;
            items.Clear();
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            shoppingList = null;
            items.Clear();
            errorMessage = "The shopping list could not be loaded because the API could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadItemsAsync()
    {
        items.Clear();
        items.AddRange(await Lists.GetListProductsAsync(Id));
    }

    private void BeginListNameEdit()
    {
        errorMessage = null;
        isEditingName = true;
        editingName = shoppingList?.Name ?? string.Empty;
    }

    private void CancelListNameEdit()
    {
        isEditingName = false;
        editingName = string.Empty;
    }

    private async Task SaveListNameAsync()
    {
        if (shoppingList is null || string.IsNullOrWhiteSpace(editingName))
        {
            errorMessage = "List name is required.";
            return;
        }

        isSavingListName = true;
        errorMessage = null;
        try
        {
            var updated = await Lists.UpdateListAsync(shoppingList.Id, editingName, shoppingList.RowVersion);
            shoppingList = shoppingList with
            {
                Name = updated.Name,
                UpdatedAt = updated.UpdatedAt,
                RowVersion = updated.RowVersion
            };
            isEditingName = false;
            statusMessage = "List name saved.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            if (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await ReloadAfterConflictAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The list name could not be saved because the API could not be reached.";
        }
        finally
        {
            isSavingListName = false;
        }
    }

    private void BeginItemDelete(ListProductDto item)
    {
        errorMessage = null;
        statusMessage = null;
        deletingItemId = item.Id;
    }

    private void CancelItemDelete()
    {
        deletingItemId = null;
    }

    private void BeginToOrderNowEdit(ListProductDto item)
    {
        errorMessage = null;
        statusMessage = null;
        editingToOrderItemId = item.Id;
        editedToOrderNow = item.ToOrderNow;
    }

    private void AdjustEditedToOrderNow(int adjustment)
    {
        if ((adjustment < 0 && editedToOrderNow > int.MinValue) ||
            (adjustment > 0 && editedToOrderNow < int.MaxValue))
        {
            editedToOrderNow += adjustment;
        }
    }

    private void CancelToOrderNowEdit()
    {
        editingToOrderItemId = null;
    }

    private async Task SaveToOrderNowAsync()
    {
        var item = editingToOrderItem;
        if (item is null)
        {
            editingToOrderItemId = null;
            return;
        }

        isSavingToOrderNow = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var updated = await Lists.UpdateListProductAsync(
                Id,
                item.Id,
                new UpdateListProductRequest(
                    item.ProductId,
                    item.TipicalOrder,
                    editedToOrderNow,
                    item.Notes,
                    item.RowVersion));
            var itemIndex = items.FindIndex(existing => existing.Id == item.Id);
            if (itemIndex >= 0)
            {
                items[itemIndex] = updated;
            }

            editingToOrderItemId = null;
            statusMessage = "Order-now quantity saved.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            if (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                editingToOrderItemId = null;
                await ReloadItemAfterConflictAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The order-now quantity could not be saved because the API could not be reached.";
        }
        finally
        {
            isSavingToOrderNow = false;
        }
    }

    private async Task DeleteItemAsync(ListProductDto item)
    {
        isSavingItem = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await Lists.DeleteListProductAsync(Id, item.Id, item.RowVersion);
            items.Remove(item);
            deletingItemId = null;
            statusMessage = "Product removed from the list.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            deletingItemId = null;
            if (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await ReloadItemAfterConflictAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product could not be removed because the API could not be reached.";
        }
        finally
        {
            isSavingItem = false;
        }
    }

    private async Task ReloadItemAfterConflictAsync()
    {
        try
        {
            await LoadItemsAsync();
            statusMessage = "The list changed elsewhere. The latest products have been loaded.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = $"{errorMessage} Could not reload the latest products: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            errorMessage = $"{errorMessage} Could not reload the latest products because the API is unavailable.";
        }
    }

    private async Task ReloadAfterConflictAsync()
    {
        try
        {
            shoppingList = await Lists.GetListAsync(Id);
            await LoadItemsAsync();
            statusMessage = "The list changed elsewhere. The latest values have been loaded.";
        }
        catch (Exception ex) when (ex is ShoppingListApiException or HttpRequestException)
        {
            errorMessage = $"{errorMessage} Could not reload the latest list.";
        }
    }
}
