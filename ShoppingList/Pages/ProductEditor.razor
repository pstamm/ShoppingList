@page "/products/new"
@page "/products/{Id:int}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IProductCatalogClient Catalog
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(IsEdit ? "Edit product" : "Add product")</PageTitle>

<h1>@(IsEdit ? "Edit product" : "Add product")</h1>

@if (isLoading)
{
    <p role="status">Loading product...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="product-editor">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="product-name">Name</label>
            <InputText id="product-name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="product-type">Product type</label>
            <InputSelect id="product-type" class="form-select" @bind-Value="model.ProductTypeId">
                <option value="0">Select a product type</option>
                @foreach (var type in productTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => model.ProductTypeId" />
            @if (productTypes.Count == 0)
            {
                <div class="alert alert-info mt-2 mb-0">
                    <div>Create a product type before saving this product.</div>
                    <div class="input-group mt-2">
                        <label class="visually-hidden" for="first-product-type">First product type name</label>
                        <InputText id="first-product-type" class="form-control" @bind-Value="newProductTypeName"
                                   placeholder="For example, Groceries" />
                        <button class="btn btn-outline-primary" type="button"
                                disabled="@(isSaving || string.IsNullOrWhiteSpace(newProductTypeName))"
                                @onclick="CreateFirstProductTypeAsync">
                            @(isSaving ? "Creating..." : "Create product type")
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label" for="product-price">Price</label>
            <InputNumber id="product-price" class="form-control" @bind-Value="model.Price" step="0.01" min="0" />
            <ValidationMessage For="() => model.Price" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="product-picture">Take a photo or choose a picture (JPEG, PNG or WebP; max 5 MB)</label>
            <InputFile id="product-picture" class="form-control" accept="image/jpeg,image/png,image/webp"
                       capture="environment" OnChange="PictureChangedAsync" />
            <button class="btn btn-outline-primary mt-2" type="button" disabled="@isSaving"
                    @onclick="StartCameraAsync">
                Use camera
            </button>
            <div class="mt-3" hidden="@(!isCameraOpen)">
                <video @ref="cameraPreview" class="catalog-editor-picture w-100" autoplay playsinline
                       aria-label="Live camera preview"></video>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary" type="button" disabled="@isSaving"
                            @onclick="CaptureCameraAsync">Take photo</button>
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="CloseCameraAsync">Close camera</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(model.PictureDataUrl))
            {
                <div class="mt-3">
                    <img class="catalog-editor-picture" src="@model.PictureDataUrl" alt="Product picture preview" />
                    <button class="btn btn-sm btn-outline-danger d-block mt-2" type="button" @onclick="RemovePictureAsync">Remove picture</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@(isSaving || productTypes.Count == 0)">
                @(isSaving ? "Saving..." : "Save")
            </button>
            <a class="btn btn-outline-secondary" href="/products">Cancel</a>
        </div>
    </EditForm>
}

@code {
    private const long MaxPictureSize = 5 * 1024 * 1024;
    private readonly ProductEditorModel model = new();
    private IReadOnlyList<ProductTypeDto> productTypes = [];
    private ProductDto? originalProduct;
    private string? errorMessage;
    private string newProductTypeName = string.Empty;
    private ElementReference cameraPreview;
    private IJSObjectReference? cameraModule;
    private bool isLoading = true;
    private bool isSaving;
    private bool clearPicture;
    private bool isCameraOpen;

    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromQuery]
    public int? ReturnToListId { get; set; }

    private bool IsEdit => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            productTypes = await Catalog.GetProductTypesAsync();
            if (Id is int id)
            {
                originalProduct = await Catalog.GetProductAsync(id);
                model.Name = originalProduct.Name;
                model.ProductTypeId = originalProduct.ProductTypeId;
                model.Price = originalProduct.Price;
                model.Picture = originalProduct.Picture;
                model.PictureContentType = originalProduct.PictureContentType;
                model.PictureWidth = originalProduct.PictureWidth;
                model.PictureHeight = originalProduct.PictureHeight;
                model.PictureDataUrl = PictureSource(originalProduct);
            }
            else
            {
                originalProduct = null;
                model.Name = string.Empty;
                model.ProductTypeId = 0;
                model.Price = 0;
                model.Picture = null;
                model.PictureContentType = null;
                model.PictureWidth = null;
                model.PictureHeight = null;
                model.PictureDataUrl = null;
                clearPicture = false;
            }
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product catalogue could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PictureChangedAsync(InputFileChangeEventArgs args)
    {
        await StopCameraAsync();
        errorMessage = null;
        var file = args.File;
        if (file.Size > MaxPictureSize)
        {
            errorMessage = "The picture exceeds the 5 MB upload limit.";
            return;
        }

        if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            errorMessage = "Choose a JPEG, PNG or WebP picture.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxPictureSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            model.Picture = memory.ToArray();
            model.PictureContentType = file.ContentType;
            model.PictureWidth = null;
            model.PictureHeight = null;
            model.PictureDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(model.Picture)}";
            clearPicture = false;
        }
        catch (IOException)
        {
            errorMessage = "The picture could not be read. Try selecting it again.";
        }
    }

    private async Task RemovePictureAsync()
    {
        await StopCameraAsync();
        model.Picture = null;
        model.PictureContentType = null;
        model.PictureWidth = null;
        model.PictureHeight = null;
        model.PictureDataUrl = null;
        clearPicture = true;
    }

    private async Task StartCameraAsync()
    {
        errorMessage = null;
        try
        {
            cameraModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/product-camera.js");
            await cameraModule.InvokeVoidAsync("startCamera", cameraPreview);
            isCameraOpen = true;
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
            isCameraOpen = false;
        }
    }

    private async Task CaptureCameraAsync()
    {
        if (cameraModule is null)
        {
            return;
        }

        errorMessage = null;
        try
        {
            model.Picture = await cameraModule.InvokeAsync<byte[]>(
                "captureCamera", cameraPreview, MaxPictureSize);
            model.PictureContentType = "image/jpeg";
            model.PictureWidth = null;
            model.PictureHeight = null;
            model.PictureDataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(model.Picture)}";
            clearPicture = false;
            await StopCameraAsync();
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CloseCameraAsync()
    {
        await StopCameraAsync();
    }

    private async Task StopCameraAsync()
    {
        isCameraOpen = false;
        if (cameraModule is not null)
        {
            try
            {
                await cameraModule.InvokeVoidAsync("stopCamera", cameraPreview);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            var request = new SaveProductRequest(
                model.Name,
                model.ProductTypeId,
                model.Price,
                clearPicture ? null : model.Picture,
                clearPicture ? null : model.PictureContentType,
                clearPicture ? null : model.PictureWidth,
                clearPicture ? null : model.PictureHeight);
            if (IsEdit)
            {
                await Catalog.UpdateProductAsync(Id!.Value, request);
                Navigation.NavigateTo("/products");
            }
            else
            {
                var createdProduct = await Catalog.CreateProductAsync(request);
                Navigation.NavigateTo(ReturnToListId is int listId && listId > 0
                    ? $"/lists/{listId}/products/new?createdProductId={createdProduct.Id}"
                    : "/products");
            }
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product could not be saved because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateFirstProductTypeAsync()
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            var productType = await Catalog.CreateProductTypeAsync(newProductTypeName.Trim());
            productTypes = [productType, .. productTypes];
            model.ProductTypeId = productType.Id;
            newProductTypeName = string.Empty;
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product type could not be created because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string? PictureSource(ProductDto product)
    {
        return product.Picture is { Length: > 0 } picture &&
               !string.IsNullOrWhiteSpace(product.PictureContentType)
            ? $"data:{product.PictureContentType};base64,{Convert.ToBase64String(picture)}"
            : null;
    }

    private sealed class ProductEditorModel
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Select a product type.")]
        public int ProductTypeId { get; set; }

        [Range(typeof(decimal), "0", "9999999999999999", ErrorMessage = "Price cannot be negative.")]
        public decimal Price { get; set; }

        public byte[]? Picture { get; set; }
        public string? PictureContentType { get; set; }
        public int? PictureWidth { get; set; }
        public int? PictureHeight { get; set; }
        public string? PictureDataUrl { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        if (cameraModule is not null)
        {
            try
            {
                await cameraModule.InvokeVoidAsync("stopCamera", cameraPreview);
                await cameraModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
