@page "/product-types"
@attribute [Authorize]
@inject IProductCatalogClient Catalog

<PageTitle>Product types</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Product types</h1>
    <a class="btn btn-outline-secondary" href="/products">Back to products</a>
</div>

<EditForm Model="createModel" OnValidSubmit="CreateAsync" FormName="create-product-type" class="row g-2 mb-4">
    <DataAnnotationsValidator />
    <div class="col-md-8">
        <label class="visually-hidden" for="new-type-name">New product type</label>
        <InputText id="new-type-name" class="form-control" placeholder="New product type name" @bind-Value="createModel.Name" />
        <ValidationMessage For="() => createModel.Name" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary" type="submit" disabled="@isSaving">Add product type</button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p role="status">Loading product types...</p>
}
else if (productTypes.Count == 0)
{
    <p>No product types have been created.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in productTypes)
                {
                    <tr>
                        <td>
                            @if (editingTypeId == type.Id)
                            {
                                <InputText class="form-control" aria-label="Product type name" @bind-Value="editingName" />
                            }
                            else
                            {
                                @type.Name
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                @if (editingTypeId == type.Id)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(type.Id)">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(type)">Edit</button>
                                    @if (deletingTypeId == type.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(type.Id)">Confirm delete</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => BeginDelete(type.Id)">Delete</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly ProductTypeForm createModel = new();
    private IReadOnlyList<ProductTypeDto> productTypes = [];
    private string? errorMessage;
    private string editingName = string.Empty;
    private int? editingTypeId;
    private int? deletingTypeId;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            productTypes = await Catalog.GetProductTypesAsync();
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product catalogue could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        await RunMutationAsync(async () =>
        {
            await Catalog.CreateProductTypeAsync(createModel.Name);
            createModel.Name = string.Empty;
        });
    }

    private void BeginEdit(ProductTypeDto type)
    {
        errorMessage = null;
        editingTypeId = type.Id;
        editingName = type.Name;
        deletingTypeId = null;
    }

    private async Task SaveEditAsync(int typeId)
    {
        if (await RunMutationAsync(async () => await Catalog.UpdateProductTypeAsync(typeId, editingName)))
        {
            editingTypeId = null;
            editingName = string.Empty;
        }
    }

    private void CancelEdit()
    {
        editingTypeId = null;
        editingName = string.Empty;
    }

    private void BeginDelete(int typeId)
    {
        deletingTypeId = typeId;
        editingTypeId = null;
        errorMessage = null;
    }

    private void CancelDelete()
    {
        deletingTypeId = null;
    }

    private async Task DeleteAsync(int typeId)
    {
        if (await RunMutationAsync(async () => await Catalog.DeleteProductTypeAsync(typeId)))
        {
            deletingTypeId = null;
        }
    }

    private async Task<bool> RunMutationAsync(Func<Task> mutation)
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            await mutation();
            await LoadAsync();
            return true;
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
            return false;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The operation could not be completed because the API could not be reached.";
            return false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ProductTypeForm
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
