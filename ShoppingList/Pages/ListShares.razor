@page "/lists/{Id:int}/share"
@attribute [Authorize]
@inject IShoppingListClient ListClient

<PageTitle>Share @list?.Name</PageTitle>

<a href="@($"/lists/{Id}")" class="btn btn-link px-0">&larr; Back to list</a>

@if (isLoading)
{
    <p role="status">Loading sharing settings...</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <h1>Sharing unavailable</h1>
    <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (list is not null)
{
    <h1>Share @list.Name</h1>
    <p>People you share this list with can view and edit it, but cannot share or delete it.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success" role="status">@statusMessage</div>
    }

    <EditForm Model="shareForm" OnValidSubmit="AddShareAsync" FormName="add-list-share" class="row g-2 mb-4">
        <DataAnnotationsValidator />
        <div class="col-md-8">
            <label class="form-label" for="share-user-id">User ID</label>
            <InputText id="share-user-id" class="form-control" autocomplete="off" @bind-Value="shareForm.UserId" />
            <ValidationMessage For="() => shareForm.UserId" />
            <div class="form-text">Enter the account's user ID. Only active accounts can be added.</div>
        </div>
        <div class="col-md-4 align-self-end">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Sharing..." : "Share list")
            </button>
        </div>
    </EditForm>

    <h2 class="h4">People with access</h2>
    @if (shares.Count == 0)
    {
        <p>This list has not been shared with anyone.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Email</th>
                        <th scope="col">User ID</th>
                        <th scope="col">Shared on</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var share in shares)
                    {
                        <tr @key="share.UserId">
                            <td>@share.Email</td>
                            <td><code>@share.UserId</code></td>
                            <td>@share.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                @if (removingUserId == share.UserId)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemoveShareAsync(share)">Confirm remove</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelRemove" disabled="@isSaving">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => BeginRemove(share)" disabled="@isSaving">Remove access</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private readonly ShareForm shareForm = new();
    private IReadOnlyList<ListShareDto> shares = [];
    private ShoppingListDto? list;
    private string? loadError;
    private string? errorMessage;
    private string? statusMessage;
    private string? removingUserId;
    private bool isLoading = true;
    private bool isSaving;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        errorMessage = null;

        try
        {
            list = await ListClient.GetListAsync(Id);
            shares = await ListClient.GetSharesAsync(Id);
        }
        catch (ShoppingListApiException ex)
        {
            list = null;
            shares = [];
            loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            list = null;
            shares = [];
            loadError = "Sharing settings could not be loaded because the API could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddShareAsync()
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var newShare = await ListClient.CreateShareAsync(Id, shareForm.UserId.Trim());
            shares = shares.Append(newShare)
                .OrderBy(share => share.Email, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            shareForm.UserId = string.Empty;
            statusMessage = $"Access granted to {newShare.Email}.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The share could not be created because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginRemove(ListShareDto share)
    {
        removingUserId = share.UserId;
        errorMessage = null;
        statusMessage = null;
    }

    private void CancelRemove()
    {
        removingUserId = null;
    }

    private async Task RemoveShareAsync(ListShareDto share)
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await ListClient.RemoveShareAsync(Id, share.UserId);
            shares = shares.Where(item => item.UserId != share.UserId).ToArray();
            removingUserId = null;
            statusMessage = $"Access removed for {share.Email}.";
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            removingUserId = null;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Access could not be removed because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ShareForm
    {
        [Required, StringLength(450)]
        public string UserId { get; set; } = string.Empty;
    }
}
