@page "/lists"
@attribute [Authorize]
@inject IShoppingListClient ListClient
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Shopping lists</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Shopping lists</h1>
</div>

<EditForm Model="createModel" OnValidSubmit="CreateAsync" FormName="create-list" class="row g-2 mb-4">
    <DataAnnotationsValidator />
    <div class="col-md-8">
        <label class="visually-hidden" for="new-list-name">New list name</label>
        <InputText id="new-list-name" class="form-control" placeholder="New shopping list name" @bind-Value="createModel.Name" />
        <ValidationMessage For="() => createModel.Name" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary" type="submit" disabled="@isSaving">Create list</button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p role="status">Loading shopping lists...</p>
}
else if (lists.Count == 0)
{
    <p>You do not have any shopping lists yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">List</th>
                    <th scope="col">Products</th>
                    <th scope="col">Last updated</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var list in lists)
                {
                    <tr>
                        <td>
                            @if (editingListId == list.Id)
                            {
                                <InputText class="form-control" aria-label="List name" @bind-Value="editingName" />
                            }
                            else
                            {
                                <a href="@($"/lists/{list.Id}")">@list.Name</a>
                            }
                        </td>
                        <td>@list.Products.Count</td>
                        <td>@list.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                @if (editingListId == list.Id)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(list)">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/lists/{list.Id}")">Open</a>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginEdit(list)">Rename</button>
                                    @if (CanDelete(list))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"/lists/{list.Id}/share")">Sharing</a>
                                        @if (deletingListId == list.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(list)">Confirm delete</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => BeginDelete(list.Id)">Delete</button>
                                        }
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="form-text">Lists containing active products cannot be deleted. Remove all products first.</p>
}

@code {
    private readonly ListForm createModel = new();
    private IReadOnlyList<ShoppingListDto> lists = [];
    private string? errorMessage;
    private string editingName = string.Empty;
    private int? editingListId;
    private int? deletingListId;
    private string? currentUserId;
    private bool isAdmin;
    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationState.GetAuthenticationStateAsync();
        currentUserId = authenticationState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isAdmin = authenticationState.User.IsInRole("Admin");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            lists = await ListClient.GetListsAsync();
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The shopping-list service could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            await ListClient.CreateListAsync(createModel.Name);
            createModel.Name = string.Empty;
            await LoadAsync();
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The list could not be created because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginEdit(ShoppingListDto list)
    {
        errorMessage = null;
        editingListId = list.Id;
        editingName = list.Name;
        deletingListId = null;
    }

    private async Task SaveEditAsync(ShoppingListDto list)
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            await ListClient.UpdateListAsync(list.Id, editingName, list.RowVersion);
            editingListId = null;
            editingName = string.Empty;
            await LoadAsync();
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            if (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await LoadAsync();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "The list could not be renamed because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelEdit()
    {
        editingListId = null;
        editingName = string.Empty;
    }

    private void BeginDelete(int listId)
    {
        deletingListId = listId;
        editingListId = null;
        errorMessage = null;
    }

    private void CancelDelete()
    {
        deletingListId = null;
    }

    private bool CanDelete(ShoppingListDto list)
    {
        return isAdmin || (!string.IsNullOrWhiteSpace(currentUserId) && list.OwnerUserId == currentUserId);
    }

    private async Task DeleteAsync(ShoppingListDto list)
    {
        errorMessage = null;
        isSaving = true;
        try
        {
            await ListClient.DeleteListAsync(list.Id, list.RowVersion);
            deletingListId = null;
            await LoadAsync();
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
            deletingListId = null;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The list could not be deleted because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ListForm
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
