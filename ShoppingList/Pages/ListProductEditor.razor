@page "/lists/{Id:int}/products/new"
@page "/lists/{Id:int}/products/{ListProductId:int}/edit"
@attribute [Authorize]
@inject IShoppingListClient Lists
@inject IProductCatalogClient Catalog
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit list product" : "Add product to list")</PageTitle>

<a href="@($"/lists/{Id}")" class="btn btn-link px-0">&larr; Back to list</a>

@if (isLoading)
{
    <p role="status">Loading product details...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage) && !isReady)
{
    <h1>Product details unavailable</h1>
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else
{
    <h1>@(IsEdit ? "Edit product in list" : "Add product to list")</h1>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="list-product-editor" class="mt-3">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="catalog-product">Product</label>
            <InputSelect id="catalog-product" class="form-select" @bind-Value="model.ProductId">
                <option value="0">Select a product</option>
                @foreach (var product in availableProducts)
                {
                    <option value="@product.Id">@product.Name (@product.Price.ToString("C"))</option>
                }
            </InputSelect>
            <ValidationMessage For="() => model.ProductId" />
            @if (!IsEdit)
            {
                <a class="btn btn-outline-primary mt-2" href="@($"/products/new?returnToListId={Id}")">Create product</a>
            }
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="tipical-order">Typical order</label>
                <InputNumber id="tipical-order" class="form-control" @bind-Value="model.TipicalOrder" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="to-order-now">Order now</label>
                <InputNumber id="to-order-now" class="form-control" @bind-Value="model.ToOrderNow" />
            </div>
        </div>

        <div class="my-3">
            <label class="form-label" for="product-notes">Notes</label>
            <InputTextArea id="product-notes" class="form-control" @bind-Value="model.Notes" maxlength="2000" rows="3" />
            <ValidationMessage For="() => model.Notes" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save")
            </button>
            <a class="btn btn-outline-secondary" href="@($"/lists/{Id}")">Cancel</a>
        </div>
    </EditForm>
}

@code {
    private readonly ListProductForm model = new();
    private IReadOnlyList<ProductDto> availableProducts = [];
    private ListProductDto? existingItem;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isReady;
    private bool isSaving;

    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public int? ListProductId { get; set; }

    [SupplyParameterFromQuery]
    public int? CreatedProductId { get; set; }

    private bool IsEdit => ListProductId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isReady = false;
        errorMessage = null;
        try
        {
            var listTask = Lists.GetListAsync(Id);
            var catalogTask = Catalog.GetProductsAsync(null, null);
            var itemsTask = Lists.GetListProductsAsync(Id);
            await Task.WhenAll(listTask, catalogTask, itemsTask);

            var listItems = await itemsTask;
            if (IsEdit)
            {
                existingItem = listItems.FirstOrDefault(item => item.Id == ListProductId);
                if (existingItem is null)
                {
                    errorMessage = "The product was not found in this list.";
                    return;
                }

                model.ProductId = existingItem.ProductId;
                model.TipicalOrder = existingItem.TipicalOrder;
                model.ToOrderNow = existingItem.ToOrderNow;
                model.Notes = existingItem.Notes;
            }

            var existingProductIds = listItems
                .Where(item => item.Id != ListProductId)
                .Select(item => item.ProductId)
                .ToHashSet();
            availableProducts = (await catalogTask)
                .Where(product => !existingProductIds.Contains(product.Id))
                .OrderBy(product => product.Name)
                .ToList();
            if (!IsEdit && CreatedProductId is int createdProductId &&
                availableProducts.Any(product => product.Id == createdProductId))
            {
                model.ProductId = createdProductId;
            }

            isReady = true;
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (CatalogApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Product details could not be loaded because the API could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (model.Notes?.Length > 2000)
        {
            errorMessage = "Notes cannot exceed 2000 characters.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            if (existingItem is null)
            {
                await Lists.AddListProductAsync(
                    Id,
                    new AddListProductRequest(
                        model.ProductId,
                        model.TipicalOrder,
                        model.ToOrderNow,
                        model.Notes));
            }
            else
            {
                await Lists.UpdateListProductAsync(
                    Id,
                    existingItem.Id,
                    new UpdateListProductRequest(
                        model.ProductId,
                        model.TipicalOrder,
                        model.ToOrderNow,
                        model.Notes,
                        existingItem.RowVersion));
            }

            Navigation.NavigateTo($"/lists/{Id}");
        }
        catch (ShoppingListApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "The product could not be saved because the API could not be reached.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ListProductForm
    {
        [Range(1, int.MaxValue, ErrorMessage = "Select a product.")]
        public int ProductId { get; set; }

        public int TipicalOrder { get; set; } = 1;
        public int ToOrderNow { get; set; } = 1;

        [StringLength(2000)]
        public string? Notes { get; set; }
    }
}
